{
  "name": "agent-guardrails-monorepo-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b --pretty false && tsc -p tooling/antidrift --pretty false",
    "lint": "pnpm lint:oxlint && pnpm lint:custom-typed && pnpm lint:boundaries && pnpm lint:exports",
    "lint:oxlint": "oxlint --disable-nested-config",
    "lint:custom-typed": "eslint . --max-warnings 0",
    "lint:boundaries": "depcruise --config .dependency-cruiser.mjs --output-type err tooling/antidrift/src apps packages",
    "lint:exports": "knip",
    "lint:json": "mkdir -p reports && eslint . --format json --output-file reports/eslint-antidrift.json || true",
    "lint:sarif": "mkdir -p reports && oxlint --disable-nested-config --format sarif > reports/oxlint.sarif || true",
    "test": "vitest run --passWithNoTests",
    "test:integration": "pnpm package:verify",
    "package:verify": "node tooling/antidrift/test/consumer-monorepo.mjs",
    "check": "pnpm verify:release",
    "check:ci": "pnpm verify:release",
    "verify:release": "pnpm policy:check-generated && pnpm policy:check-registries && pnpm policy:check-rule-surface && pnpm typecheck && pnpm lint && pnpm test && pnpm package:verify",
    "policy:generate": "antidrift generate",
    "policy:check-generated": "antidrift check-generated",
    "policy:check-registries": "antidrift check-registries",
    "policy:check-rule-surface": "antidrift check-rule-surface",
    "policy:validate-corpus": "node tooling/antidrift/research/cli.mjs repo-corpus --slice validation-gate",
    "policy:research-external-corpus": "node tooling/antidrift/research/cli.mjs external-corpus --slice external-local",
    "policy:benchmark-sql-queries": "node tooling/antidrift/research/cli.mjs benchmark-sql-queries --slice upstream-delta --output reports/sql-query-benchmark.json",
    "policy:inventory-defensive-shape": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-defensive-shape --slice defensive-shape-sunset --output reports/defensive-shape-inventory.json",
    "policy:inventory-declaration-clone": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-declaration-clone --slice declaration-clone-research --repo agent-guardrails-monorepo-template --output reports/declaration-clone-inventory.json",
    "policy:inventory-declaration-clone-source-fleet": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-declaration-clone --slice declaration-clone-source-fleet --repo sudocode-main,opencode --output reports/declaration-clone-source-fleet-inventory.json",
    "policy:inventory-sql-broad": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-sql-broad --slice broad-sql-promotion --output reports/sql-broad-inventory.json",
    "policy:inventory-sql-source-fleet": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-sql-broad --slice broad-sql-source-fleet --repo LibreChat,agent-browser,athena-crisis,cloudflare-agents,codex,codiff,excalidraw-mcp-app,figma-console-mcp,frontend-coding-challenge,hunk,opencode,pierre,powersync-service,rubber,sandcastle,site-greater-co,sudocode-main,usurper --output reports/sql-broad-inventory-source-fleet.json",
    "policy:inventory-react-state": "node tooling/antidrift/research/cli.mjs inventory-react-state --slice react-state --output reports/react-state-inventory.json",
    "policy:inventory-underchecked-predicate": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-underchecked-predicate --slice underchecked-predicate-promotion --output reports/underchecked-predicate-inventory.json",
    "policy:inventory-type-owner": "NODE_OPTIONS=--max-old-space-size=8192 node tooling/antidrift/research/cli.mjs inventory-type-owner --slice upstream-delta --output reports/type-owner-inventory.json",
    "policy:inventory-change-contract": "node tooling/antidrift/research/cli.mjs change-contract",
    "policy:validate-change-contract-evidence": "node tooling/antidrift/research/cli.mjs change-contract-evidence --output reports/change-contract-evidence.json",
    "policy:inventory-diff-scoped-adapters": "node tooling/antidrift/research/cli.mjs diff-scoped-adapters",
    "policy:repo-corpus": "node tooling/antidrift/research/cli.mjs repo-corpus",
    "policy:check:changed": "antidrift check-changed",
    "policy:verify-session": "antidrift verify-session",
    "policy:reports": "pnpm lint:json && pnpm lint:sarif",
    "sonar:prepare": "pnpm lint:json",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@joedeleeuw/antidrift": "workspace:*",
    "@joedeleeuw/typescript-tooling": "github:joedeleeuw/typescript-tooling",
    "@types/node": "catalog:core",
    "dependency-cruiser": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-sonarjs": "catalog:lint",
    "knip": "catalog:lint",
    "lint-staged": "catalog:git",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "prettier": "catalog:lint",
    "simple-git-hooks": "catalog:git",
    "tsx": "catalog:core",
    "typescript": "catalog:core",
    "vitest": "catalog:test"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "oxlint --disable-nested-config --fix",
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,jsonc,md,mdc,yml,yaml}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --no-stash",
    "pre-push": "pnpm policy:verify-session"
  }
}
