{
  "name": "antidrift-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b --pretty false && tsc -p tooling/antidrift --pretty false",
    "lint": "pnpm lint:rust && pnpm lint:oxlint && pnpm lint:boundaries && pnpm lint:exports",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo run --quiet -p antidrift-linter -- rust",
    "parity:rust": "node tooling/antidrift/test/rust-parity.mjs",
    "lint:oxlint": "antidrift oxlint",
    "lint:boundaries": "depcruise --config .dependency-cruiser.mjs --output-type err tooling/antidrift/src apps packages",
    "lint:exports": "knip",
    "lint:sarif": "mkdir -p reports && antidrift oxlint -- --format sarif > reports/oxlint.sarif || true",
    "test:integration": "pnpm package:verify",
    "package:verify": "node tooling/antidrift/test/consumer-monorepo.mjs",
    "check": "pnpm verify:release",
    "check:ci": "pnpm verify:release",
    "verify:release": "pnpm policy:check-generated && pnpm policy:check-registries && pnpm parity:rust && pnpm typecheck && pnpm lint && pnpm package:verify",
    "policy:generate": "antidrift generate",
    "policy:check-generated": "antidrift check-generated",
    "policy:check-registries": "antidrift check-registries",
    "policy:inventory-change-contract": "antidrift change-contract",
    "policy:validate-change-contract-evidence": "antidrift change-contract-evidence --output reports/change-contract-evidence.json",
    "policy:inventory-diff-scoped-adapters": "antidrift diff-scoped-adapters",
    "policy:check:changed": "antidrift check-changed",
    "policy:verify-session": "antidrift verify-session",
    "policy:reports": "pnpm lint:sarif",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@joedeleeuw/antidrift": "workspace:*",
    "@joedeleeuw/typescript-tooling": "github:joedeleeuw/typescript-tooling#0f9ce5d52ca962471ae1774620f9f77389669bc1",
    "@types/node": "catalog:core",
    "dependency-cruiser": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-plugin-boundaries": "^5.0.1",
    "knip": "catalog:lint",
    "lint-staged": "catalog:git",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "prettier": "catalog:lint",
    "simple-git-hooks": "catalog:git",
    "tsx": "catalog:core",
    "typescript": "catalog:core"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "antidrift oxlint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --no-stash",
    "pre-push": "pnpm policy:verify-session"
  }
}
