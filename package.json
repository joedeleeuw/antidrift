{
  "name": "@joedeleeuw/antidrift",
  "version": "0.28.7",
  "type": "module",
  "license": "MIT",
  "description": "Host-agnostic Oxlint and ESLint rules for TypeScript, React, boundary decoding, and AI-agent drift prevention.",
  "keywords": [
    "oxlint",
    "eslint",
    "lint",
    "guardrails",
    "ai",
    "agents",
    "typescript",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joedeleeuw/antidrift.git"
  },
  "homepage": "https://github.com/joedeleeuw/antidrift#readme",
  "bugs": "https://github.com/joedeleeuw/antidrift/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./oxlint-plugin": {
      "types": "./src/oxlint-plugin/index.d.ts",
      "import": "./src/oxlint-plugin/index.js"
    },
    "./eslint-plugin": {
      "types": "./src/oxlint-plugin/index.d.ts",
      "import": "./src/oxlint-plugin/index.js"
    },
    "./oxlint-config": {
      "types": "./src/oxlint-config/index.d.ts",
      "import": "./src/oxlint-config/index.js"
    },
    "./eslint-config": {
      "types": "./src/eslint-config/index.d.ts",
      "import": "./src/eslint-config/index.js"
    },
    "./preset": {
      "types": "./src/oxlint-config/index.d.ts",
      "import": "./src/oxlint-config/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint -c oxlint.config.mts src scripts oxlint.config.mts",
    "fallow": "fallow dead-code && fallow dupes --fail-on-issues",
    "smoke": "node scripts/verify-smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm fallow && pnpm smoke",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0"
  },
  "devDependencies": {
    "@joedeleeuw/typescript-tooling": "github:joedeleeuw/typescript-tooling#a4bf4ef73914038ec2c0bdbc925bdf332d7dc94f",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "fallow": "3.38.1",
    "lint-staged": "^15.3.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,mts}": [
      "oxlint -c oxlint.config.mts --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --no-stash",
    "pre-push": "pnpm check"
  }
}
