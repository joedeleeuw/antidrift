{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.mjs",
    "src/**/*.js",
    "scripts/**/*.ts",
    "test/**/*.mjs"
  ],
  "exclude": ["src/**/fixtures/**", "src/**/*.test.*"]
}
