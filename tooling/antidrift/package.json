{
  "name": "@joedeleeuw/antidrift",
  "version": "0.18.3",
  "type": "module",
  "license": "MIT",
  "description": "Deterministic Oxlint and TypeScript-aware policy guardrails against code and AI-agent drift.",
  "keywords": [
    "oxlint",
    "lint",
    "guardrails",
    "ai",
    "agents",
    "codegen",
    "policy",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joedeleeuw/antidrift.git",
    "directory": "tooling/antidrift"
  },
  "homepage": "https://github.com/joedeleeuw/antidrift#readme",
  "bugs": "https://github.com/joedeleeuw/antidrift/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "types": "./dist/index.d.mts",
    "bin": {
      "antidrift": "dist/policy/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./brand": {
        "types": "./dist/brand/index.d.mts",
        "import": "./dist/brand/index.mjs"
      },
      "./oxlint-config": {
        "types": "./dist/oxlint-config/index.d.mts",
        "import": "./dist/oxlint-config/index.mjs"
      },
      "./policy": {
        "types": "./dist/policy/index.d.mts",
        "import": "./dist/policy/index.mjs"
      }
    }
  },
  "types": "./src/index.d.mts",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./package.json": "./package.json",
    "./brand": {
      "types": "./src/brand/index.d.mts",
      "import": "./src/brand/index.mjs"
    },
    "./oxlint-config": {
      "types": "./src/oxlint-config/index.d.mts",
      "import": "./src/oxlint-config/index.mjs"
    },
    "./policy": {
      "types": "./src/policy/index.d.mts",
      "import": "./src/policy/index.mjs"
    }
  },
  "bin": {
    "antidrift": "src/policy/cli.mjs"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "pnpm run build"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "licenses",
    "README.md",
    "ast-grep",
    "dist"
  ],
  "dependencies": {
    "oxlint": "1.89.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "eslint": ">=9.38.0 <11",
    "typescript": ">=5 <6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "catalog:lint",
    "typescript": "6.0.3"
  }
}
